# Copy this file to .env.local and fill in what you have. Nothing here is required:
# with no key at all the game still runs, and imagines things with its own built-in tables.

# Claude models (Haiku 4.5 is the default; Sonnet 5.5 can be chosen in the game's menu)
ANTHROPIC_API_KEY=

# GPT models (GPT-5.4 mini / nano, GPT-5.6 Terra and GPT-6 Luna appear in the game's menu when this is set)
OPENAI_API_KEY=

# Sounds for typed things (Leonardo sound effects, about $0.009 each). Without it, things are silent.
LEONARDO_API_KEY=

# Optional
# PORT=8787
# PRIMORDIA_MODEL=claude-haiku-4-5-20251001        the default model
# PRIMORDIA_MODELS=id,id                           offer only these models
# PRIMORDIA_AI_PER_HOUR=60                         paid model calls one player may cause per hour
# PRIMORDIA_SOUNDS_PER_HOUR=                       sounds one player may cause per hour
# PRIMORDIA_DAILY_CALLS=1500                       paid model calls per day, all players together
# PRIMORDIA_REUSE=0.7                              how often a kept answer is reused instead of asking a model
# PRIMORDIA_PRICES={"model-id":[in,out,cachedIn]}  add or correct a price (US dollars per million tokens)
# PRIMORDIA_MAX_GENS=150                           generations one away catch-up may run
# PRIMORDIA_ADMIN=some-secret                      needed for /api/tick and /api/usage when set
# PRIMORDIA_ORIGIN=https://your.site               allowed browser origin
# PRIMORDIA_DATA=./data                            where ponds, the library and the cost books are kept
# PRIMORDIA_GAME=./game/game.html                  which game file /dev serves
# PRIMORDIA_PUBLIC=../../all-games-website/public  where Plaxzy's sound library is served from
